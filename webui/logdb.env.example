# Flight log database settings: copy to /etc/flight-logs/logdb.env and edit.
# Commented-out settings use the default shown. Check with: python3 app.py check-config

# --- Server ---
# Address users open, e.g. https://logs.example.org. Used for the SAML URLs; when empty they follow the request
LOGDB_PUBLIC_URL=https://logs.example.org
# Address:port gunicorn (and `python3 app.py`) listens on
#LOGDB_BIND=127.0.0.1:8000
# Gunicorn threads (there is always exactly one gunicorn process)
#LOGDB_THREADS=8
# Log a warning (journalctl) for a request slower than this, and for a write that waits more than half of it for the database write lock or holds it longer than this; 0 turns these warnings off
#LOGDB_SLOW_REQUEST_MS=2000
# Number of reverse proxies (nginx/Caddy) in front of the app. Set to 1 behind a proxy so client addresses and https are seen correctly; keep 0 when clients connect directly
LOGDB_PROXIES=1
# Web pages on other origins that may call /api with an API key, e.g. https://app.indiflight.org (comma-separated; * allows any page). Default: none
#LOGDB_CORS_ORIGINS=
# Exclude flights without a linked fleet aircraft from statistics, logbook person details and locations; admins still link them under Unlinked names on Aircraft
#LOGDB_HIDE_UNLINKED_AIRCRAFT=0
# 1 shows Training: in-app questionnaires that can grant a qualification on a pass
#LOGDB_TRAINING=0
# 1 shows Agenda: a week agenda of bookable items that administrators set up
#LOGDB_BOOKINGS=0
# 1 adds Outdoor operations to the Agenda (needs LOGDB_BOOKINGS): plan and book outdoor flights at bookable locations, shared by teams
#LOGDB_OPERATIONS=0
# Page Plan flight links to for checking NOTAMs and drone zones (default: no link)
#LOGDB_NOTAM_URL=
# Time zone of the Agenda's local times (slots, Plan flight, the forecast, booking mails) and of the local times next to the UTC times of flights
#LOGDB_TIME_ZONE=Europe/Amsterdam
# 1 shows Documents: shared documents that administrators upload, and each person's own current qualifications
#LOGDB_DOCUMENTS=0
# 1 shows Safety (/safety): danger, incident and accident reports. The Operations Manual links /safety: keep it on in production
#LOGDB_SAFETY=0
# 1 lets administrators view and use the site as another user, from that person's page (passwords, API keys and script sign-ins stay blocked; start and stop are logged)
#LOGDB_VIEW_AS=0
# 1 asks everyone who signs in for their role, department, supervisors, expected end date and student/employee number (again once the end date has passed)
#LOGDB_PERSON_PROFILE=0

# --- Appearance ---
# Name in tab titles, on the sign-in page, in email subjects and in the header when no logo is set
#LOGDB_SITE_NAME=Flight logbook
# Logo in the header and on the sign-in page: NAME of static/logos/NAME.svg (NAME-white.svg is used on dark backgrounds when present). When unset the header shows LOGDB_SITE_NAME
#LOGDB_SITE_LOGO=
# Text at the bottom of every page, before the Web UI version (default: LOGDB_SITE_NAME)
#LOGDB_FOOTER_TEXT=
# Logos above the footer text, comma-separated NAME or NAME=https://link, e.g. tudelft=https://www.tudelft.nl (default: none)
#LOGDB_FOOTER_LOGOS=

# --- Storage and parsing ---
# Local directory with the database, session key and SAML keys. Keep it on a local disk: SQLite must not run on a network share
LOGDB_WEB_DATA=/var/lib/flight-logs
# Directory for compressed logs, flight paths and attachments; may be a network share (default: WEB_DATA/logs)
LOGDB_LOG_DIR=/mnt/flight-logs/logs
# Where `app.py backup` writes a consistent copy of the database and keys (overwritten each time; may be a network share)
LOGDB_BACKUP_DIR=/mnt/flight-logs/backup
# Allow backups when the destination cannot enforce chmod 600. Enable only when share/host ACLs restrict access to trusted operators
#LOGDB_BACKUP_EXTERNAL_PERMISSIONS=0
# Parser binary
#LOGDB_FASTREADER=../cpp/build/paparazzi_log_parsing
# Betaflight/INDIFlight Blackbox decoder binary
#LOGDB_BLACKBOX_DECODE=../cpp/build/blackbox_decode
# Resolve firmware commit dates via GitHub automatically during parsing (sends revision hashes, never log contents). 0 disables lookups and week estimates
#LOGDB_FIRMWARE_GITHUB_ENABLED=1
# Additional public/private GitHub owner/repository names, comma-separated; direct hash lookups also cover non-default branches
#LOGDB_FIRMWARE_GITHUB_REPOS=your-team/paparazzi,your-user/paparazzi
# Server-side GitHub token with read access to configured private repositories; optional for public lookups. Never put credentials in repository names
#LOGDB_FIRMWARE_GITHUB_TOKEN=
# Logs parsed in parallel; increase only with sufficient RAM and local temporary disk
#LOGDB_WORKERS=1
# Background threads that hash, deduplicate and unzip uploads
#LOGDB_INGEST_WORKERS=1
# MATLAB exports converted at the same time (each uses a few CPU cores and local temporary disk about the size of the uncompressed log)
#LOGDB_EXPORT_WORKERS=1
# Local disk kept for finished MATLAB exports (kept two weeks; the oldest are removed first above this size; default: 50 GiB)
#LOGDB_EXPORT_MAX_BYTES=53687091200
# Local disk headroom retained while staging/decompressing uploads (default: 2 GiB; additional space is needed for parser output)
#LOGDB_LOCAL_MIN_FREE_BYTES=2147483648
# Flight path points stored per second (0 disables the map path)
#LOGDB_PATH_RATE=5
# Maximum original size per attachment in bytes (default: 10 GiB)
#LOGDB_ATTACHMENT_MAX_BYTES=10737418240
# Categories of attachments, comma-separated, in display order; files keep a category removed from this list
#LOGDB_ATTACHMENT_CATEGORIES=Preparation & permits, Notes, Media, Data, Analysis, Archive
# LibreOffice binary that converts .docx attachments to PDF for viewing in the browser: 'auto' uses soffice from PATH if installed, 'off' disables, or a full path
#LOGDB_OFFICE=auto
# ffmpeg binary that makes thumbnails of image and video attachments for the Home page: 'auto' uses ffmpeg from PATH if installed, 'off' disables, or a full path
#LOGDB_FFMPEG=auto
# Global job budget for cooperating bulk upload scripts
#LOGDB_BULK_MAX_PENDING=8
# Estimated pending byte budget for bulk uploads (16 GiB)
#LOGDB_BULK_MAX_BYTES=17179869184
# Years a log with a real flight and a paper record are kept after the flight: until then they cannot be deleted (hide them instead), except by an administrator with a reason that is kept. EU 2019/947 asks for at least 3; 0 turns the rule off
#LOGDB_RETENTION_YEARS=3

# --- Login ---
# 1 when the site is served over https (cookies are then only sent over https)
LOGDB_COOKIE_SECURE=1
# How long a login lasts
#LOGDB_SESSION_HOURS=12
# Session signing key (default: generated once in WEB_DATA/secret_key)
#LOGDB_SECRET_KEY=

# --- Email ---
# Mail relay for notifications, e.g. the organisation's SMTP server; no email is sent when unset
#LOGDB_SMTP_HOST=
# Mail relay port (465 uses TLS from the start)
#LOGDB_SMTP_PORT=25
# 1 switches to TLS with STARTTLS before sending (needed when SMTP_USER is set on most relays)
#LOGDB_SMTP_STARTTLS=0
# Mail relay user name, if the relay needs a login
#LOGDB_SMTP_USER=
# Mail relay password
#LOGDB_SMTP_PASSWORD=
# Sender address of the notifications, e.g. a functional mailbox of the organisation
#LOGDB_MAIL_FROM=
# Sender name shown with LOGDB_MAIL_FROM (default: LOGDB_SITE_NAME)
#LOGDB_MAIL_FROM_NAME=
# Text at the bottom of every mail, above the link to the email settings; \n starts a new line (default: the sender name)
#LOGDB_MAIL_FOOTER=
# Shared mailbox for administrator notices (qualifications to approve, logs that failed to parse); when unset each administrator gets them as chosen in My account
#LOGDB_MAIL_ADMIN_TO=
# Local hour after which the daily summaries and expiry reminders are sent
#LOGDB_MAIL_DAILY_HOUR=7

# --- TU Delft SAML login ---
# 0 hides the 'Sign in with TU Delft' button
#LOGDB_SAML_ENABLED=1
# Identity provider metadata
#LOGDB_SAML_METADATA_URL=https://login.tudelft.nl/sso/saml2/idp/metadata.php
# This service's SAML entity ID (default: <PUBLIC_URL>/saml/metadata)
#LOGDB_SAML_ENTITY_ID=
# 1 signs people in without a click when they already have a TU Delft session (silent check on the login page); 0 always shows the login page
#LOGDB_SAML_PASSIVE=1
