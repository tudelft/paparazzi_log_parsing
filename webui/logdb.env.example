# Flight log database settings: copy to /etc/flight-logs/logdb.env and edit.
# Commented-out settings use the default shown. Check with: python3 app.py check-config

# --- Server ---
# Address users open, e.g. https://logs.example.org. Used for the SAML URLs; when empty they follow the request
LOGDB_PUBLIC_URL=https://logs.example.org
# Address:port gunicorn (and `python3 app.py`) listens on
#LOGDB_BIND=127.0.0.1:8000
# Gunicorn threads (there is always exactly one gunicorn process)
#LOGDB_THREADS=8
# Number of reverse proxies (nginx/Caddy) in front of the app. Set to 1 behind a proxy so client addresses and https are seen correctly; keep 0 when clients connect directly
LOGDB_PROXIES=1

# --- Storage and parsing ---
# Local directory with the database, session key and SAML keys. Keep it on a local disk: SQLite must not run on a network share
LOGDB_WEB_DATA=/var/lib/flight-logs
# Directory for compressed logs, flight paths and attachments; may be a network share (default: WEB_DATA/logs)
LOGDB_LOG_DIR=/mnt/flight-logs/logs
# Where `app.py backup` writes a consistent copy of the database and keys (overwritten each time; may be a network share)
LOGDB_BACKUP_DIR=/mnt/flight-logs/backup
# Parser binary
#LOGDB_FASTREADER=../cpp/build/paparazzi_log_parsing
# Logs parsed in parallel (default: 2-4 depending on the CPU count)
#LOGDB_WORKERS=
# Background threads that hash, deduplicate and unzip uploads
#LOGDB_INGEST_WORKERS=2
# Flight path points stored per second (0 disables the map path)
#LOGDB_PATH_RATE=5
# Maximum original size per attachment in bytes (default: 10 GiB)
#LOGDB_ATTACHMENT_MAX_BYTES=10737418240

# --- Login ---
# 1 when the site is served over https (cookies are then only sent over https)
LOGDB_COOKIE_SECURE=1
# How long a login lasts
#LOGDB_SESSION_HOURS=12
# Session signing key (default: generated once in WEB_DATA/secret_key)
#LOGDB_SECRET_KEY=

# --- TU Delft SAML login ---
# 0 hides the 'Sign in with TU Delft' button
#LOGDB_SAML_ENABLED=1
# Identity provider metadata
#LOGDB_SAML_METADATA_URL=https://login.tudelft.nl/sso/saml2/idp/metadata.php
# This service's SAML entity ID (default: <PUBLIC_URL>/saml/metadata)
#LOGDB_SAML_ENTITY_ID=

# --- Pilot licences ---
# GitHub token with read access to the Operations repo, so the app can show certificate PDFs without everyone needing GitHub
#LOGDB_OPERATIONS_TOKEN=
# owner/name of the Operations repository
#LOGDB_OPERATIONS_REPO=tudelft/Operations
# Branch that holds the Pilots folder
#LOGDB_OPERATIONS_REF=EU_OPS
# Folder of per-pilot certificate PDFs
#LOGDB_OPERATIONS_PILOTS_PATH=Outdoor_Flight/Pilots
